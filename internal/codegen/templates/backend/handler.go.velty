package handler

import (
	"github.com/gin-gonic/gin"

	response "youlai-gin/internal/common"
	"youlai-gin/internal/common/auth"
	appContext "youlai-gin/internal/common/context"
	"youlai-gin/internal/common/validator"
	"youlai-gin/internal/middleware"
	"youlai-gin/internal/${moduleName}/${entityKebab}/model"
	"youlai-gin/internal/${moduleName}/${entityKebab}/service"
	"youlai-gin/pkg/enums"
)

// Handler ${businessName}接口层
type Handler struct {
	svc *service.Service
}

// NewHandler 创建 Handler 实例
func NewHandler(svc *service.Service) *Handler {
	return &Handler{svc: svc}
}

// RegisterRoutes 注册${businessName}路由
func (h *Handler) RegisterRoutes(r *gin.RouterGroup) {
	items := r.Group("/${entityKebabPlural}")
	{
		items.GET("", auth.RequirePermission("${permissionPrefix}:list"), h.Page)
		items.POST("", auth.RequirePermission("${permissionPrefix}:create"), middleware.OperationLog(enums.LogModuleOther, enums.ActionTypeInsert), h.Create)
		items.GET("/:id/form", auth.RequirePermission("${permissionPrefix}:update"), h.GetForm)
		items.PUT("/:id", auth.RequirePermission("${permissionPrefix}:update"), middleware.OperationLog(enums.LogModuleOther, enums.ActionTypeUpdate), h.Update)
		items.DELETE("/:ids", auth.RequirePermission("${permissionPrefix}:delete"), middleware.OperationLog(enums.LogModuleOther, enums.ActionTypeDelete), h.Delete)
	}
}

// Page ${businessName}分页列表
// @Summary ${businessName}分页列表
// @Tags ${businessName}管理
// @Success 200 {object} map[string]interface{}
// @Router /api/v1/${entityKebabPlural} [get]
func (h *Handler) Page(c *gin.Context) {
	var query model.${entityName}Query
	if err := validator.BindQuery(c, &query); err != nil {
		c.Error(err)
		return
	}

	result, err := h.svc.Page(c.Request.Context(), &query)
	if err != nil {
		c.Error(err)
		return
	}

	response.OkPaged(c, result)
}

// Create 新增${businessName}
// @Summary 新增${businessName}
// @Tags ${businessName}管理
// @Param body body model.${entityName}Form true "${businessName}信息"
// @Success 200 {object} map[string]interface{}
// @Router /api/v1/${entityKebabPlural} [post]
func (h *Handler) Create(c *gin.Context) {
	var form model.${entityName}Form
	if err := validator.BindJSON(c, &form); err != nil {
		c.Error(err)
		return
	}

	if err := h.svc.Create(appContext.OperatorCtx(c), &form); err != nil {
		c.Error(err)
		return
	}

	response.OkMsg(c, "保存成功")
}

// GetForm 获取${businessName}表单数据
// @Summary 获取${businessName}表单数据
// @Tags ${businessName}管理
// @Param id path int true "ID"
// @Success 200 {object} map[string]interface{}
// @Router /api/v1/${entityKebabPlural}/{id}/form [get]
func (h *Handler) GetForm(c *gin.Context) {
	id, err := appContext.ParsePathParam(c, "id", "${businessName}")
	if err != nil {
		c.Error(err)
		return
	}

	form, err := h.svc.Get(c.Request.Context(), id)
	if err != nil {
		c.Error(err)
		return
	}

	response.Ok(c, form)
}

// Update 修改${businessName}
// @Summary 修改${businessName}
// @Tags ${businessName}管理
// @Param id path int true "ID"
// @Param body body model.${entityName}Form true "${businessName}信息"
// @Success 200 {object} map[string]interface{}
// @Router /api/v1/${entityKebabPlural}/{id} [put]
func (h *Handler) Update(c *gin.Context) {
	id, err := appContext.ParsePathParam(c, "id", "${businessName}")
	if err != nil {
		c.Error(err)
		return
	}

	var form model.${entityName}Form
	if err := validator.BindJSON(c, &form); err != nil {
		c.Error(err)
		return
	}

	if err := h.svc.Update(appContext.OperatorCtx(c), id, &form); err != nil {
		c.Error(err)
		return
	}

	response.OkMsg(c, "更新成功")
}

// Delete 删除${businessName}
// @Summary 删除${businessName}
// @Tags ${businessName}管理
// @Param ids path string true "ID，多个以英文逗号分隔"
// @Success 200 {object} map[string]interface{}
// @Router /api/v1/${entityKebabPlural}/{ids} [delete]
func (h *Handler) Delete(c *gin.Context) {
	ids, err := appContext.ParseIntList(c.Param("ids"), "${businessName}")
	if err != nil {
		c.Error(err)
		return
	}

	if err := h.svc.Delete(appContext.OperatorCtx(c), ids); err != nil {
		c.Error(err)
		return
	}

	response.OkMsg(c, "删除成功")
}
