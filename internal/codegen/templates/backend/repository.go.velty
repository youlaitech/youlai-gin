package repository

import (
	"context"

	"gorm.io/gorm"

	"youlai-gin/internal/${moduleName}/${entityKebab}/model"
)

// Repository ${businessName}数据访问层
type Repository struct {
	db *gorm.DB
}

// NewRepository 创建 Repository 实例
func NewRepository(db *gorm.DB) *Repository {
	return &Repository{db: db}
}

// Page ${businessName}分页查询
func (r *Repository) Page(ctx context.Context, query *model.${entityName}Query) ([]model.${entityName}, int64, error) {
	var list []model.${entityName}
	var total int64

	db := r.db.WithContext(ctx).Model(&model.${entityName}{})
#if($hasIsDeleted)
	db = db.Where("is_deleted = 0")
#end
#foreach($fieldConfig in $fieldConfigsInQuery)
#if($fieldConfig.queryType == "BETWEEN")
	if len(query.${fieldConfig.goFieldName}) == 2 {
		db = db.Where("${fieldConfig.columnName} BETWEEN ? AND ?", query.${fieldConfig.goFieldName}[0], query.${fieldConfig.goFieldName}[1])
	}
#elseif($fieldConfig.queryType == "IN")
	if len(query.${fieldConfig.goFieldName}) > 0 {
		db = db.Where("${fieldConfig.columnName} IN ?", query.${fieldConfig.goFieldName})
	}
#elseif($fieldConfig.queryType == "LIKE")
	if ${fieldConfig.queryIsSetExpr} {
		db = db.Where("${fieldConfig.columnName} LIKE ?", "%"+${fieldConfig.queryArgExpr}+"%")
	}
#elseif($fieldConfig.queryType == "LIKE_LEFT")
	if ${fieldConfig.queryIsSetExpr} {
		db = db.Where("${fieldConfig.columnName} LIKE ?", "%"+${fieldConfig.queryArgExpr})
	}
#elseif($fieldConfig.queryType == "LIKE_RIGHT")
	if ${fieldConfig.queryIsSetExpr} {
		db = db.Where("${fieldConfig.columnName} LIKE ?", ${fieldConfig.queryArgExpr}+"%")
	}
#elseif($fieldConfig.queryType == "GT")
	if ${fieldConfig.queryIsSetExpr} {
		db = db.Where("${fieldConfig.columnName} > ?", ${fieldConfig.queryArgExpr})
	}
#elseif($fieldConfig.queryType == "GE")
	if ${fieldConfig.queryIsSetExpr} {
		db = db.Where("${fieldConfig.columnName} >= ?", ${fieldConfig.queryArgExpr})
	}
#elseif($fieldConfig.queryType == "LT")
	if ${fieldConfig.queryIsSetExpr} {
		db = db.Where("${fieldConfig.columnName} < ?", ${fieldConfig.queryArgExpr})
	}
#elseif($fieldConfig.queryType == "LE")
	if ${fieldConfig.queryIsSetExpr} {
		db = db.Where("${fieldConfig.columnName} <= ?", ${fieldConfig.queryArgExpr})
	}
#elseif($fieldConfig.queryType == "NE")
	if ${fieldConfig.queryIsSetExpr} {
		db = db.Where("${fieldConfig.columnName} != ?", ${fieldConfig.queryArgExpr})
	}
#else
	if ${fieldConfig.queryIsSetExpr} {
		db = db.Where("${fieldConfig.columnName} = ?", ${fieldConfig.queryArgExpr})
	}
#end
#end
	if err := db.Count(&total).Error; err != nil {
		return nil, 0, err
	}

#if($hasCreateTime)
	order := "create_time DESC"
#else
	order := "id DESC"
#end
	if err := db.Offset(query.GetOffset()).Limit(query.GetLimit()).Order(order).Find(&list).Error; err != nil {
		return nil, 0, err
	}

	return list, total, nil
}

// Get 根据 ID 查询${businessName}
func (r *Repository) Get(ctx context.Context, id int64) (*model.${entityName}, error) {
	var item model.${entityName}
	db := r.db.WithContext(ctx).Where("id = ?", id)
#if($hasIsDeleted)
	db = db.Where("is_deleted = 0")
#end
	if err := db.First(&item).Error; err != nil {
		return nil, err
	}
	return &item, nil
}

// Create 创建${businessName}（ctx 携带操作人，由审计钩子填充 create_by/update_by）
func (r *Repository) Create(ctx context.Context, item *model.${entityName}) error {
	return r.db.WithContext(ctx).Create(item).Error
}

// Update 更新${businessName}
func (r *Repository) Update(ctx context.Context, id int64, form *model.${entityName}Form) error {
	updates := map[string]interface{}{
#foreach($fieldConfig in $fieldConfigsInForm)		"${fieldConfig.columnName}": form.${fieldConfig.goFieldName},
#end	}
	return r.db.WithContext(ctx).Model(&model.${entityName}{}).Where("id = ?", id).Updates(updates).Error
}

// Delete 删除${businessName}
func (r *Repository) Delete(ctx context.Context, ids []int64) error {
	if len(ids) == 0 {
		return nil
	}
	db := r.db.WithContext(ctx).Model(&model.${entityName}{}).Where("id IN ?", ids)
#if($hasIsDeleted)
	return db.Update("is_deleted", 1).Error
#else
	return db.Delete(&model.${entityName}{}).Error
#end}
