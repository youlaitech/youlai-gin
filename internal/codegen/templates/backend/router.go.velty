package ${entityPackage}

import (
	"github.com/gin-gonic/gin"
	"gorm.io/gorm"

	"youlai-gin/internal/${moduleName}/${entityKebab}/handler"
	"youlai-gin/internal/${moduleName}/${entityKebab}/repository"
	"youlai-gin/internal/${moduleName}/${entityKebab}/service"
)

// RegisterRoutes 装配${businessName}模块（repository → service → handler）
// 在 internal/system/router.go 的 RegisterRoutes 中调用：${entityPackage}.RegisterRoutes(r, db)
func RegisterRoutes(r *gin.RouterGroup, db *gorm.DB) {
	handler.NewHandler(service.NewService(repository.NewRepository(db))).RegisterRoutes(r)
}
