<template>
  <CrudPage
    :search-config="searchConfig"
    :table-config="tableConfig"
    :form-config="formConfig"
    :load-form-data="loadFormData"
  >
#foreach($field in $fieldConfigsInQuery)#if($field.hasDictType)    <template #search-${field.fieldName}="{ formData, prop, attrs }">
      <DictSelect v-model="formData[prop]" code="$field.dictType" v-bind="attrs" />
    </template>#end#end
#foreach($field in $fieldConfigsInList)#if($field.hasDictType)    <template #table-cell-${field.fieldName}="{ row }">
      <DictTag :model-value="row.${field.fieldName}" code="$field.dictType" />
    </template>#end#end
#foreach($field in $fieldConfigsInForm)#if($field.hasDictType)    <template #form-${field.fieldName}="{ formData, prop, attrs }">
      <DictSelect v-model="formData[prop]" code="$field.dictType" v-bind="attrs" />
    </template>#end#end
  </CrudPage>
</template>

<script setup>
import ${entityName}API from "@/api/${moduleName}/${entityKebab}";

defineOptions({ name: "$entityName", inheritAttrs: false });

const searchConfig = {
  fields: [
#foreach($field in $fieldConfigsInQuery)    {
      prop: "$field.fieldName",
      label: "$field.fieldComment",
#if($field.hasDictType)      type: "custom",
      attrs: { clearable: true },
#elseif($field.isDate)      type: "date-picker",
#if($field.queryType == "BETWEEN")      initialValue: [],
      attrs: {
        type: "daterange",
        valueFormat: "YYYY-MM-DD",
        startPlaceholder: "开始日期",
        endPlaceholder: "结束日期",
      },
#elseif($field.isDateTime)      attrs: { type: "datetime", valueFormat: "YYYY-MM-DD HH:mm:ss", clearable: true },
#else      attrs: { type: "date", valueFormat: "YYYY-MM-DD", clearable: true },
#end#elseif($field.isNumeric)      type: "input-number",
      attrs: { clearable: true },
#else      type: "input",
      attrs: { clearable: true },
#end    },
#end  ],
};

const tableConfig = {
  permissionPrefix: "${permissionPrefix}",
  table: { border: true },
  fetchData: ${entityName}API.getPage,
  deleteByIds: ${entityName}API.deleteByIds,
  toolbarActions: ["create", "delete"],
  tableTools: ["refresh", "columns", "search"],
  columns: [
    { type: "selection", width: 50 },
#foreach($field in $fieldConfigsInList)    { prop: "$field.fieldName", label: "$field.fieldComment", minWidth: 120 },
#end    {
      prop: "actions",
      label: "操作",
      cellType: "actions",
      actions: ["view", "edit", "delete"],
      fixed: "right",
      width: 200,
    },
  ],
};

const formConfig = {
  title: ({ mode }) => ({
    create: "新增$!{entityComment}",
    edit: "编辑$!{entityComment}",
    view: "查看$!{entityComment}",
  })[mode],
  dialog: { width: 560 },
  /**
   * 保存记录，更新目标使用打开表单时的主键。
   */
  submitForm(data, { mode, id }) {
    if (mode === "create") return ${entityName}API.create(data);
    if (id === undefined) throw new Error("缺少记录 ID");
    return ${entityName}API.update(String(id), data);
  },
  fields: [
#foreach($field in $fieldConfigsInForm)    {
      prop: "$field.fieldName",
      label: "$field.fieldComment",
#if($field.requiredInForm)      required: true,
#end#if($field.hasDictType)      type: "custom",
#elseif($field.formType == "SWITCH")      type: "switch",
#if($field.fieldType == "Boolean")      initialValue: true,
      attrs: { activeValue: true, inactiveValue: false },
#else      initialValue: 1,
      attrs: { activeValue: 1, inactiveValue: 0 },
#end#elseif($field.isDate)      type: "date-picker",
#if($field.isDateTime)      attrs: { type: "datetime", valueFormat: "YYYY-MM-DD HH:mm:ss" },
#else      attrs: { type: "date", valueFormat: "YYYY-MM-DD" },
#end#elseif($field.formType == "INPUT_NUMBER")      type: "input-number",
#if($field.isDecimal)      attrs: { precision: 2 },
#end#elseif($field.formType == "SELECT")      type: "select",
      options: [],
#elseif($field.formType == "RADIO")      type: "radio",
      options: [],
#elseif($field.formType == "CHECK_BOX")      type: "checkbox",
      initialValue: [],
      options: [],
#else      type: "input",
#if($field.formType == "TEXT_AREA")      attrs: { type: "textarea", rows: 3 },
#end#end    },
#end  ],
};

/**
 * 加载编辑和查看所需的详情。
 */
function loadFormData(row) {
  const rowKey = tableConfig.rowKey ?? "id";
  return ${entityName}API.getFormData(String(row[rowKey]));
}
</script>
