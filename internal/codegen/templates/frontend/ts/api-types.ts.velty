/**
 * ${entityName} ${businessName}类型定义
 */

import type { PageQuery } from "@/api/common";

/** ${businessName}查询参数 */
export interface ${entityName}QueryParams extends PageQuery {
#foreach($fieldConfig in $fieldConfigsInQuery)#if($fieldConfig.fieldComment != "")  /** ${fieldConfig.fieldComment} */
#end  ${fieldConfig.fieldName}#if($fieldConfig.isBetweenNonDate)#else?#end: ${fieldConfig.tsQueryType};
#end}

/** ${businessName}表单对象 */
export interface ${entityName}Form {
  id?: string;
#foreach($fieldConfig in $fieldConfigsInForm)#if($fieldConfig.fieldName != "id")#if($fieldConfig.fieldComment != "")  /** ${fieldConfig.fieldComment} */
#end  ${fieldConfig.fieldName}?: ${fieldConfig.tsType};
#end#end}

/** ${businessName}详情对象 */
export type ${entityName}Detail = ${entityName}Item & ${entityName}Form;

/** ${businessName}列表项 */
export interface ${entityName}Item {
  /** 稳定主键，不受列表显示配置影响 */
  id: string;
#foreach($fieldConfig in $fieldConfigsInList)#if($fieldConfig.fieldName != "id")#if($fieldConfig.fieldComment != "")  /** ${fieldConfig.fieldComment} */
#end  ${fieldConfig.fieldName}?: ${fieldConfig.tsType};
#end#end}
